# Slack — from api.slack.com/apps → your app
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_APP_TOKEN=xapp-your-app-token   # only needed for Socket Mode (not used here)

# Supabase — from supabase.com → your project → Settings → API
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # use service role (not anon) for backend

# App
PORT=3000
FRONTEND_URL=https://your-vercel-app.vercel.app  # for CORS
