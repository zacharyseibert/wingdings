{
  "expo": {
    "name": "Wingdings",
    "slug": "wingdings",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "wingdings",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A0F0A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.zacharyseibert.wingdings"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1A0F0A",
        "foregroundImage": "./assets/icon.png"
      },
      "package": "com.zacharyseibert.wingdings"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#E8722A",
          "sounds": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
