{
  "expo": {
    "name": "Wingdings",
    "slug": "wingdings",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "wingdings",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.zacharyseibert.wingdings"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1A0F0A",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "package": "com.zacharyseibert.wingdings"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
